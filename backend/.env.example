# Copy to backend/.env and fill in. Never commit the real .env.

# SQLite locally. In deployment use PostgreSQL (Supabase / Neon), e.g.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./edibyte.db

# LLM: gemini | anthropic | openai | none
# Leave as "none" (or leave the key blank) to run in OFFLINE MODE.
LLM_PROVIDER=none
# Model name for the chosen provider, e.g. a Gemini, Claude or GPT model id.
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_S=25

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Photo input (needs a vision-capable model). Off by default.
ENABLE_PHOTO=false

# Simple per-IP limits
RATE_LIMIT_PER_MINUTE=60
COACH_RATE_LIMIT_PER_MINUTE=15

# Logs never include user text unless this is true
LOG_USER_TEXT=false

# Fuzzy match threshold (0-100)
MATCH_THRESHOLD=82

# Calorie floors (targets are never returned below these)
MIN_KCAL_FLOOR_MALE=1500
MIN_KCAL_FLOOR_FEMALE=1200
MIN_KCAL_FLOOR_UNSPECIFIED=1500
