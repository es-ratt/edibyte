# Copy to web/.env.local
# Backend URL (no trailing slash). Leave empty for demo mode.
# Production API (Render): https://edibyte-api.onrender.com
# For GitHub Pages, set it as the repository variable VITE_API_BASE_URL (Settings > Secrets and variables > Actions > Variables).
VITE_API_BASE_URL=http://localhost:8000
# true = built-in demo adapter (sample data, "Demo data" banner). Defaults to true when no API URL is set.
VITE_USE_MOCK_DATA=false
